# VPS endpoint
STROY_SERVER_URL=https://stroy.mostdef.ru
STROY_WORKER_ID=home-gpu-01
STROY_WORKER_NAME=Home GPU Workstation
STROY_WORKER_TOKEN=replace-with-high-entropy-worker-token
STROY_WORKER_POLL_SECONDS=5
STROY_WORKER_HEARTBEAT_SECONDS=20

# Qwen local endpoint
STROY_LLM_BASE_URL=http://127.0.0.1:8001/v1
STROY_LLM_API_KEY=local
STROY_LLM_MODEL=Qwen/Qwen3-14B

# ComfyUI local endpoint
STROY_COMFYUI_URL=http://127.0.0.1:8188
STROY_IMAGE_MODEL_PROFILE=flux-dev-family

# Blender
STROY_BLENDER_BIN=blender

# Local caches/work dirs
STROY_WORKFLOW_DIR=./workflows
STROY_WORKER_CACHE_DIR=./cache/worker
STROY_RENDER_DIR=./renders
