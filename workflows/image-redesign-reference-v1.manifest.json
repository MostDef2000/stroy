{
  "id": "image-redesign-reference-v1",
  "version": "0.1.0",
  "model_profile": "flux-dev-family",
  "required_inputs": [
    "prompt",
    "negative_prompt",
    "seed",
    "strength",
    "base_image",
    "reference_image"
  ],
  "outputs": [
    "image"
  ],
  "schema_version": "0.1.0",
  "bindings": {
    "prompt": {
      "node_id": "9",
      "input_name": "text"
    },
    "negative_prompt": {
      "node_id": "10",
      "input_name": "text"
    },
    "seed": {
      "node_id": "13",
      "input_name": "seed"
    },
    "strength": {
      "node_id": "13",
      "input_name": "denoise"
    },
    "base_image": {
      "node_id": "6",
      "input_name": "image"
    },
    "reference_image": {
      "node_id": "25",
      "input_name": "image"
    }
  },
  "graph": {
    "3": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "flux1-dev-kontext_fp8_scaled.safetensors",
        "weight_dtype": "default"
      }
    },
    "4": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "t5xxl_fp8_e4m3fn_scaled.safetensors",
        "clip_name2": "clip_l.safetensors",
        "type": "flux2"
      }
    },
    "5": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "ae.safetensors"
      }
    },
    "6": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "8": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "6",
          0
        ],
        "vae": [
          "5",
          0
        ]
      }
    },
    "9": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "4",
          0
        ]
      }
    },
    "10": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "4",
          0
        ]
      }
    },
    "11": {
      "class_type": "FluxGuidance",
      "inputs": {
        "guidance": 2.5,
        "conditioning": [
          "9",
          0
        ]
      }
    },
    "24": {
      "class_type": "IPAdapterFluxLoader",
      "inputs": {
        "ipadapter": "ip-adapter.bin",
        "clip_vision": "google/siglip-so400m-patch14-384",
        "provider": "cuda"
      }
    },
    "25": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "27": {
      "class_type": "ApplyIPAdapterFlux",
      "inputs": {
        "model": [
          "3",
          0
        ],
        "ipadapter_flux": [
          "24",
          0
        ],
        "image": [
          "25",
          0
        ],
        "weight": 0.85,
        "start_percent": 0.0,
        "end_percent": 1.0
      }
    },
    "13": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 20,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 0.6,
        "model": [
          "27",
          0
        ],
        "positive": [
          "11",
          0
        ],
        "negative": [
          "10",
          0
        ],
        "latent_image": [
          "8",
          0
        ]
      }
    },
    "14": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "13",
          0
        ],
        "vae": [
          "5",
          0
        ]
      }
    },
    "15": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "stroy-redesign",
        "images": [
          "14",
          0
        ]
      }
    }
  },
  "notes": "Reference-based whole-room redesign (v0.1.0). img2img over the uploaded room photo: node 6 LoadImage(base_image) -> node 8 VAEEncode -> KSampler 13 latent_image, so the base frame's structure is preserved; KSampler.denoise is driven by the semantic input 'strength' (0.2-0.95, higher = more change). The reference interior conditions identity/style through the Shakker-Labs comfyui-ipadapter-flux pair: node 24 IPAdapterFluxLoader (ip-adapter.bin + google/siglip-so400m-patch14-384, provider cuda) and node 27 ApplyIPAdapterFlux patching the UNET (node 3) with node 25 LoadImage(reference_image); node 27's weight is driven by ipa_weight at execution time (0.0 when no reference is supplied). Positive prompt flows CLIPTextEncode 9 -> FluxGuidance 11 -> KSampler positive; negative prompt is CLIPTextEncode 10 -> KSampler negative. Node classes are a subset of image-edit-kontext-v0's classes plus VAEEncode (no mask/inpaint nodes)."
}
