# Canonical nginx vhost template (VHOST-CANON) for stroy.mostdef.ru.
# This file is a TEMPLATE copied to /etc/nginx/sites-available/stroy.mostdef.ru on the VPS;
# never commit the installed copy.
# The canonical set is TWO files: this vhost template AND
# stroy-ratelimit.conf.example (installed as /etc/nginx/conf.d/stroy-ratelimit.conf,
# http context). The sha256 of BOTH files will be recorded in issue #130 after
# live-vhost sync.
#
# add_header inheritance trap: declaring ANY add_header inside a `location`
# cancels ALL add_header directives inherited from the server block. So every
# location that emits its own header MUST repeat the complete server-level
# security-header set below; locations with no add_header inherit the set.
# All security headers carry `always` so they are sent on 4xx/5xx too;
# Cache-Control deliberately omits `always` (must not appear on error pages).

server {
    listen 80;
    server_name stroy.mostdef.ru;

    # ACME challenge is served from a stable webroot OUTSIDE the release tree
    # (/var/www/stroy-acme), so renewals never depend on a deploy and the
    # deploy wrapper NEVER writes there. Previously this location was dead
    # code: a server-level `return 301` short-circuited before any location
    # matched (issue #123 peer finding, fixed in #130).
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/stroy-acme;
        try_files $uri =404;
    }

    # Everything else is redirected to HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name stroy.mostdef.ru;

    # Note: The SSL certificate must be issued (e.g., via certbot) before enabling this vhost.
    # TLS certificates managed by certbot (certbot --nginx or webroot on the existing nginx)
    ssl_certificate /etc/letsencrypt/live/stroy.mostdef.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stroy.mostdef.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 100M;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Security headers (inherited by all locations that declare no add_header of
    # their own). `always` is required so they are emitted on 4xx/5xx as well —
    # the `return 404` deny locations rely on inheritance for exactly this.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=63072000" always;
    # SPA-compatible CSP, kept strict (no 'unsafe-inline'): the built bundle is
    # fully self-hosted (no inline script/style, same-origin API fetch/XHR).
    # `img-src data:` is the only permissive source — a safety net for
    # runtime-generated image previews (e.g. canvas -> dataURL), never for
    # scripts or styles.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'" always;

    # Proxy headers (inherited by all proxy locations)
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # Rate-limited auth paths (defense-in-depth over app-level LoginThrottle,
    # which only covers the login route). Covers login, /me, logout and future
    # auth endpoints.
    # Zone stroy_auth (10r/m per IP) is declared in /etc/nginx/conf.d/stroy-ratelimit.conf
    # (issue #125): 5 excess requests are served immediately (`nodelay`), further
    # excess is rejected with 429 until the bucket drains. More-specific prefix wins over the generic /api/ location
    # below (nginx prefix matching selects the longest matching prefix).
    # No add_header here: the 5 server-level security headers stay inherited.
    location /api/v1/auth/ {
        limit_req zone=stroy_auth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
    }
    # Backend API proxy
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
    }
    location = /health {
        proxy_pass http://127.0.0.1:8000;
    }
    location = /ready {
        proxy_pass http://127.0.0.1:8000;
    }
    # Edge defense-in-depth for issue #122 (the app already disables these in
    # production). Plain `return 404` with no add_header so the server-level
    # security headers above stay inherited by these locations.
    location /docs {
        return 404;
    }
    location /redoc {
        return 404;
    }
    location /openapi.json {
        return 404;
    }

    # Static web assets. `current` is an atomic symlink repointed by the deploy
    # wrapper to /var/www/stroy.mostdef.ru/releases/<sha> (issue #130).
    root /var/www/stroy.mostdef.ru/current;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long-term cache for hashed assets.
    # add_header here cancels inheritance: repeat ALL 5 security headers (with
    # `always`) plus this location's own Cache-Control (no `always`).
    location /assets/ {
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        add_header Strict-Transport-Security "max-age=63072000" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'" always;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # No-cache for the entry point.
    # add_header here cancels inheritance: repeat ALL 5 security headers (with
    # `always`) plus this location's own Cache-Control (no `always`).
    location = /index.html {
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        add_header Strict-Transport-Security "max-age=63072000" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}
