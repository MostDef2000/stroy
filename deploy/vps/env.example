# VPS control plane
STROY_ENV=production
STROY_LOG_LEVEL=INFO
STROY_PUBLIC_BASE_URL=https://stroy.mostdef.ru
STROY_TRUSTED_HOSTS=stroy.mostdef.ru

# PostgreSQL
STROY_DATABASE_URL=postgresql://stroy:replace-me@postgres:5432/stroy

# Redis
STROY_REDIS_URL=redis://redis:6379/0

# MinIO / S3-compatible storage
STROY_S3_ENDPOINT=http://minio:9000
STROY_S3_ACCESS_KEY=replace-me
STROY_S3_SECRET_KEY=replace-me
STROY_S3_BUCKET=stroy
STROY_S3_REGION=local

# Owner auth
STROY_AUTH_MODE=owner-password
STROY_AUTH_USERNAME=owner
STROY_AUTH_PASSWORD_HASH=replace-with-argon2id-hash
STROY_SESSION_SECRET=replace-with-high-entropy-secret
STROY_SESSION_COOKIE_SECURE=true
STROY_SESSION_COOKIE_SAMESITE=lax
STROY_SESSION_MAX_AGE_SECONDS=604800

# Worker auth/control
# Store only through VPS secret management in production.
STROY_WORKER_TOKEN_HASH=replace-with-worker-token-hash
STROY_WORKER_LEASE_SECONDS=120
STROY_WORKER_HEARTBEAT_GRACE_SECONDS=60
