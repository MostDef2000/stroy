# Copy to deploy/vps/.env on the VPS. Never commit the real file.

POSTGRES_PASSWORD=replace-with-high-entropy-password
MINIO_ROOT_USER=stroy
MINIO_ROOT_PASSWORD=replace-with-high-entropy-password

STROY_PUBLIC_BASE_URL=https://stroy.mostdef.ru
# Host header allowlist (TrustedHostMiddleware). Must include the internal
# hostname `api` — otherwise the job worker in the compose network fails to
# register with `400 Invalid host header`. Starlette strips the port before
# matching, so `api` covers `Host: api:8000`.
STROY_TRUSTED_HOSTS=stroy.mostdef.ru,api
STROY_AUTH_MODE=owner-password
STROY_AUTH_USERNAME=owner
STROY_AUTH_PASSWORD_HASH=replace-with-argon2id-hash
STROY_SESSION_SECRET=replace-with-high-entropy-secret
STROY_SESSION_COOKIE_SECURE=true
STROY_SESSION_COOKIE_SAMESITE=lax
STROY_SESSION_MAX_AGE_SECONDS=604800

# Prefer hashes in production. During rotation, list active SHA-256 hashes comma-separated.
STROY_WORKER_TOKEN=
STROY_WORKER_TOKEN_HASH=
STROY_WORKER_TOKEN_HASHES=replace-with-current-sha256-hash
STROY_WORKER_LEASE_SECONDS=120
STROY_WORKER_HEARTBEAT_GRACE_SECONDS=60

STROY_S3_BUCKET=stroy
STROY_S3_REGION=local

# The worker runtime token is NOT stored in this file. Put it in
# deploy/vps/.worker-env (chmod 600, gitignored, compose env_file
# required:false):
#   STROY_WORKER_TOKEN=<token>
#
# To run the REAL style vision analysis (qwen3-vl via ollama on the home PC,
# reverse-tunneled to the VPS loopback: ssh -N -R 127.0.0.1:11434:127.0.0.1:11434),
# add to .worker-env instead of the mock default:
#   STROY_STYLE_VISION_ADAPTER=local
#   STROY_LLM_BASE_URL=http://host.docker.internal:11434/v1
#   STROY_LLM_API_KEY=ollama
#   STROY_LLM_MODEL=qwen3-vl:8b
#   STROY_LLM_MODEL_PROFILE=qwen3-vl-8b
#   STROY_LLM_TIMEOUT_SECONDS=120  # vision encoding can be slow after idle
#
# API-side note: settings.llm_model_profile (below) is only the payload
# default for llm jobs; the style profile provenance now comes from the
# worker adapter, so it stays accurate even if this default is stale.
# STROY_LLM_MODEL_PROFILE=qwen3-14b
