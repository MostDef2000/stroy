FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml alembic.ini ./
COPY src ./src
COPY migrations ./migrations
COPY workflows ./workflows

RUN python -m pip install --no-cache-dir .

# Non-root runtime (trivy DS-0002): the app needs no filesystem writes in
# production (s3 storage, postgres over network, bytecode disabled above).
RUN useradd --create-home --uid 10001 stroy

USER stroy

CMD ["sh", "-c", "alembic upgrade head && uvicorn stroy.api.main:app --host 0.0.0.0 --port 8000"]
