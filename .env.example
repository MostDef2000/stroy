# Core
STROY_ENV=development
STROY_LOG_LEVEL=INFO

# PostgreSQL
STROY_DATABASE_URL=postgresql+asyncpg://stroy:stroy@localhost:5432/stroy

# Redis
STROY_REDIS_URL=redis://localhost:6379/0

# S3-compatible asset storage
STROY_STORAGE_BACKEND=s3
STROY_MAX_UPLOAD_BYTES=104857600
STROY_UPLOAD_ALLOWED_MEDIA_TYPES=image/*,video/*,model/*,application/pdf,application/json,application/octet-stream,text/plain
STROY_S3_ENDPOINT=http://localhost:9000
STROY_S3_ACCESS_KEY=stroy
STROY_S3_SECRET_KEY=stroy-development-only
STROY_S3_BUCKET=stroy
STROY_S3_REGION=local

# Model profiles and Qwen / local OpenAI-compatible LLM endpoint
STROY_MODEL_PROFILES_PATH=./config/model-profiles.json
STROY_MODEL_USE=personal-non-commercial
STROY_LLM_MODEL_PROFILE=qwen3-14b
STROY_LLM_BASE_URL=http://localhost:8001/v1
STROY_LLM_API_KEY=local

# ComfyUI
STROY_COMFYUI_URL=http://localhost:8188
STROY_IMAGE_MODEL_PROFILE=flux1-schnell

# Blender
STROY_BLENDER_BIN=blender
STROY_BLENDER_SCRIPT=blender/stroy_blender.py
STROY_BLENDER_TIMEOUT_SECONDS=900

# Repository paths
STROY_WORKFLOW_DIR=./workflows
STROY_RENDER_DIR=./renders

# Local application/authentication
STROY_PUBLIC_BASE_URL=http://localhost:5173
STROY_TRUSTED_HOSTS=localhost,127.0.0.1
STROY_AUTH_MODE=owner-password
STROY_AUTH_USERNAME=owner
# Generate with: python scripts/hash_password.py
STROY_AUTH_PASSWORD_HASH=replace-with-argon2id-hash
STROY_SESSION_SECRET=replace-with-random-local-secret
STROY_SESSION_COOKIE_SECURE=false
STROY_SESSION_COOKIE_SAMESITE=lax
STROY_SESSION_MAX_AGE_SECONDS=604800

# Local/fake remote worker
STROY_WORKER_TOKEN=development-worker-token
STROY_WORKER_POLL_SECONDS=5
STROY_WORKER_LEASE_SECONDS=120
STROY_WORKER_HEARTBEAT_SECONDS=20
