# Core
STOY_ENV=development
STOY_LOG_LEVEL=INFO

# PostgreSQL
STOY_DATABASE_URL=postgresql://stoy:stoy@localhost:5432/stoy

# Redis
STOY_REDIS_URL=redis://localhost:6379/0

# S3-compatible asset storage
STOY_S3_ENDPOINT=http://localhost:9000
STOY_S3_ACCESS_KEY=stoy
STOY_S3_SECRET_KEY=stoy-development-only
STOY_S3_BUCKET=stoy
STOY_S3_REGION=local

# Qwen / local OpenAI-compatible LLM endpoint
STOY_LLM_BASE_URL=http://localhost:8001/v1
STOY_LLM_API_KEY=local
STOY_LLM_MODEL=Qwen/Qwen3-14B

# ComfyUI
STOY_COMFYUI_URL=http://localhost:8188
STOY_IMAGE_MODEL_PROFILE=flux1-schnell

# Blender
STOY_BLENDER_BIN=blender

# Repository paths
STOY_WORKFLOW_DIR=./workflows
STOY_RENDER_DIR=./renders
