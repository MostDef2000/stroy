{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stroy.local/schemas/plan-draft.schema.json",
  "title": "STROY Plan Draft",
  "type": "object",
  "required": [
    "version",
    "units",
    "scale",
    "floors"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "const": "mm"
    },
    "scale": {
      "$ref": "#/$defs/scale"
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/floor"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scale": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "plan_label",
            "manual",
            "unknown"
          ]
        },
        "mm_per_px": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "opening": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "t",
        "width_mm",
        "height_mm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "door",
            "window",
            "arch"
          ]
        },
        "t": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sill_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "wall": {
      "type": "object",
      "required": [
        "id",
        "x1",
        "y1",
        "x2",
        "y2",
        "thickness_mm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x1": {
          "type": "number"
        },
        "y1": {
          "type": "number"
        },
        "x2": {
          "type": "number"
        },
        "y2": {
          "type": "number"
        },
        "thickness_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opening"
          }
        }
      },
      "additionalProperties": false
    },
    "room": {
      "type": "object",
      "required": [
        "id",
        "name",
        "wall_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "wall_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "floor_finish": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "floor": {
      "type": "object",
      "required": [
        "name",
        "level_mm",
        "walls",
        "rooms"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "level_mm": {
          "type": "number"
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wall"
          }
        },
        "rooms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/room"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
