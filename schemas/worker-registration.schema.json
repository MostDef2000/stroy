{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stroy.local/schemas/worker-registration.schema.json",
  "title": "STROY Worker Registration",
  "type": "object",
  "required": ["schema_version", "worker_id", "capabilities", "models", "runtimes"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "worker_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string"},
    "capabilities": {
      "type": "array",
      "items": {"enum": ["llm", "style_analysis", "image_generation", "image_edit", "blender_render", "geometry_quality"]}
    },
    "models": {"type": "array", "items": {"type": "string"}},
    "runtimes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {"type": "string"},
          "status": {"enum": ["ready", "unavailable", "degraded"]}
        },
        "required": ["status"],
        "additionalProperties": true
      }
    },
    "hardware": {
      "type": "object",
      "properties": {
        "gpu_name": {"type": "string"},
        "vram_bytes": {"type": "integer", "minimum": 0},
        "ram_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}